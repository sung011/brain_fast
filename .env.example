POSTGRES_DB=mediscan_note
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
DATABASE_URL=postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5432/mediscan_note

# 세션 쿠키 서명용. 아래 중 하나로 새 값을 만든 뒤 .env 에 넣는다.
# python3 -c "import secrets; print(secrets.token_hex(32))"
# openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

# Hugging Face (MedGemma gated 모델·앙상블 체크포인트)
# https://huggingface.co/settings/tokens 에서 발급
HF_TOKEN=
HF_REPO=kimsungil/Brain_Hemorrhage
# 1이면 출혈 앙상블과 함께 germinoma CT 앙상블도 로드·추론
ENABLE_GERMINOMA=1

# MedGemma: api=HF Inference API / template=앙상블 요약(권장·토큰 Inference 불필요) / local=8GB 다운로드
MEDGEMMA_BACKEND=template
# api 실패 시 template 자동 대체 (1=켜기, 0=오류 그대로)
MEDGEMMA_FALLBACK_TEMPLATE=1

# 네이버 클라우드 Object Storage (S3 호환). 키 값은 .env 에만 둔다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET=
NCP_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_REGION=kr-standard
# DB에 저장하는 웹 경로 prefix. 버킷 안 객체 키와 같다.
NAS_BASE_PATH=/stylesheets/assets
NAS_REVIEW_PATH=/stylesheets/assets/review
NAS_PUBLIC_ROOT=/web/mu_shop/public
# <img> 주소. 예) https://kr.object.ncloudstorage.com/버킷이름
NAS_PUBLIC_BASE_URL=https://kr.object.ncloudstorage.com
# 분석 후 원본·overlay·result.json 자동 업로드
NAS_UPLOAD_ON_ANALYZE=false

# 무릎 MRI 분석: 가중치를 받을 Hugging Face 저장소 (각자 계정. 예: 내계정/Knee_MRI)
KNEE_HF_REPO=
# (선택) 검토한 커밋 해시를 적으면 그 버전만 내려받는다
KNEE_HF_REVISION=
# (선택) 저장소가 비공개일 때만: 그 저장소 하나만 읽을 수 있는 읽기 전용 토큰. 뇌용 HF_TOKEN 과 별개이며 깃·채팅에 올리지 않는다
# 비어 있으면 토큰을 아예 보내지 않는다(뇌용 HF_TOKEN·로그인 캐시 토큰도 쓰지 않음). 공개 저장소는 그대로 받아지고 비공개는 거절된다
KNEE_HF_TOKEN=
# 1이면 서버 시작 때 무릎 모델을 미리 로드
LOAD_KNEE_ON_STARTUP=
# 무릎 화면 캡처 한 장 분석 API(POST /api/v1/knee/screen-roi). 0이면 이 주소를 닫는다(기본 열림)
KNEE_SCREEN_ROI_ENABLED=
# 분석 제한 시간(초). 넘으면 504 (기본 30)
KNEE_SCREEN_ROI_TIMEOUT_S=

# 무릎 넘기며 분석(POST /api/v1/knee/screen-analysis, 10~20장 → ACL 시상면 모델 하나). 0 이면 닫음(기본 1)
KNEE_SCREEN_ANALYSIS_ENABLED=
# 넘기며 분석 제한 시간(초). 넘으면 504, 계산이 끝날 때까지 다음 요청은 429 (기본 60)
KNEE_SCREEN_ANALYSIS_TIMEOUT_S=
# 별도 ACL 위치 박스 허용(정확히 1). 미설정·0·잘못된 값은 위치만 보류하며 점수·한 장 열지도·뇌 분석은 유지.
# 운영 복구는 이 서버 설정을 0으로 하고 승인된 재시작 절차 사용. 실제 .env 대신 프로세스 환경변수로도 지정 가능.
KNEE_SCREEN_LOCALIZATION_ENABLED=
# 넘기며 분석 모델 장치. cuda 로 적고 GPU 가 있을 때만 GPU, 그 밖에는 CPU (기본 cpu)
KNEE_SCROLL_DEVICE=
# 무릎 한 장 분석('선택 영역 분석', capture_intent=single) 모델 폴더(사용자 Colab 반입본 v1: model_state.pt·preprocess.json·model_manifest.json·report.json).
# 코드에 고정한 SHA-256 과 같은 파일만 불러온다. 비우면 한 장 분석은 503(여러 장 모델로 대신하지 않음). Git·공개 정적 폴더·NAS 웹 폴더에 두지 말 것.
KNEE_SINGLE_BUNDLE_DIR=
# 무릎 화면 분석 점수의 비교 기준선 sidecar(보정 v2, MSN-20261021-001). 코드에 고정한 SHA-256 과 같은 파일만 쓴다. 비우면 raw 점수만(score_only).
#  - 한 장: calibration 181 로 정하고 과거 사용 내부 test 로 확인한 비교선·참고구간(새 독립 시험 아님). 시상면·영상 한 장 전체에만 적용.
KNEE_SINGLE_CALIBRATION_FILE=
#  - 넘기며(볼륨): 학습에 노출된 자료로 정한 탐색 참고선. 서버가 가운데 연속 15장 조건을 확인한 경우만(일반 화면 공유는 확인 불가 → 생략).
KNEE_VOLUME_REFERENCE_FILE=

# 무릎 학습 ROI 채점(POST /learning/roi-grade/knee). 1 일 때만 동작한다(기본 꺼짐).
# 켜기 전에 승인된 기준 ROI와 영상 공급원이 준비되어야 한다. 학습자 로그인 세션(session["learner"])은 POST /login 이 만든다
# (발표 한정 관리자 승인 예외: 관리자가 만든 회원이 로그인하면 승인된 학습자. email_verified=True 는 이메일 인증 완료가 아니다).
# (단일 이미지: class/knee/reference_rois.py, 슬라이드: class/knee/slide_references.py. 둘 다 지금은 비어 있다)
KNEE_ROI_GRADE_ENABLED=
# 슬라이드(여러 장) 문제의 대표 슬라이스 채점용 설정. 모두 비어 있으면 안전한 쪽(슬라이드 문제는 채점하지 않음)으로 동작한다.
# 슬라이드 이미지 경로로 허용하는 루트(쉼표로 구분, 각 루트는 /로 시작하고 /로 끝남). 예: /assets/knee/
KNEE_ASSET_ROOTS=
# 문제 제시 토큰(problem_token) 서명 키: 32자 이상 무작위 문자열, 세션 SECRET_KEY 와 다른 값. 깃·채팅에 올리지 않는다
KNEE_PROBLEM_TOKEN_KEY=
# 토큰 유효 시간(초). 비우면 7200(2시간), 60~86400 으로 제한
KNEE_PROBLEM_TOKEN_TTL_S=
# 무릎 학습 영상 공급원(둘 중 **하나만** 설정한다. 둘 다 설정하거나 둘 다 비우면 영상을 내보내지 않고 닫힌다).
# 서버가 영상을 읽어 승인된 해시(SHA-256)·PNG 치수와 대조한 바이트만 로그인한 학습자에게 보여 준다.
# (1) NAS: 영상이 있는 NAS 공개 기준 주소(https 만). 주소 + 문제 목록의 경로로 가져온다. 예: https://nas.example.com/mu_shop/public
KNEE_NAS_IMAGE_BASE_URL=
# (2) 서버 폴더: 절대 경로의 실제 폴더. 앱의 assets/·templates/ 안은 안 된다(정적 공개 금지). 폴더 안 링크는 거절한다.
KNEE_IMAGE_DIR=
# 시험 전용(로컬 가짜 NAS 의 http 허용). 운영에서는 절대 설정하지 않는다.
KNEE_NAS_ALLOW_HTTP=
# 무릎 MRI 게스트 실제 영상 열람(로그인 없이 탐색·박스 연습만, 채점·풀이 저장 없음, MSN-20261016-002). 기본 꺼짐: 정확히 1 일 때만 켜진다.
KNEE_GUEST_VIEW_ENABLED=
# 게스트 시작/종료를 허용할 프런트 Origin(정확히 일치, 쉼표 구분, * 불가). 예: http://192.168.0.10:8080  — 비우면 게스트는 닫힌다
KNEE_GUEST_ALLOWED_ORIGINS=
# 게스트 쿠키 Secure 속성. 기본(비움)=Secure(HTTPS). 발표용 HTTP 에서만 0 으로 명시. 한도는 단일 백엔드 프로세스 기준(다중 프로세스면 게스트를 끈다)
KNEE_GUEST_COOKIE_SECURE=
